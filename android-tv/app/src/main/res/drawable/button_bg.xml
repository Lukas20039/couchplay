<?xml version="1.0" encoding="utf-8"?>
<!-- Fokuszustand gut sichtbar (Fernbedienung): gelber Rahmen wie in der Web-UI. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="32dp" />
            <solid android:color="@color/cp_primary" />
            <stroke android:width="5dp" android:color="@color/cp_focus" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="32dp" />
            <solid android:color="@color/cp_primary" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="32dp" />
            <solid android:color="@color/cp_surface_2" />
        </shape>
    </item>
</selector>
