<?xml version="1.0" encoding="utf-8"?>
<!-- D-Pad-taugliche Einstellungen: Eingabefeld + große, fokussierbare Buttons. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="96dp"
        android:paddingTop="56dp"
        android:paddingEnd="96dp"
        android:paddingBottom="48dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_title"
            android:textColor="@color/cp_text"
            android:textSize="40sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:labelFor="@+id/server_url"
            android:text="@string/settings_server_label"
            android:textColor="@color/cp_text"
            android:textSize="22sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/server_url"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:autofillHints=""
            android:background="@drawable/input_bg"
            android:hint="@string/settings_server_hint"
            android:imeOptions="actionDone|flagNoExtractUi"
            android:inputType="textUri"
            android:maxLines="1"
            android:minHeight="64dp"
            android:nextFocusDown="@+id/save"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:textColor="@color/cp_text"
            android:textColorHint="@color/cp_muted"
            android:textSize="24sp" />

        <TextView
            android:id="@+id/error"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/settings_invalid"
            android:textColor="@color/cp_danger"
            android:textSize="18sp"
            android:visibility="gone" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/settings_server_help"
            android:textColor="@color/cp_muted"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/default_url"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/cp_muted"
            android:textSize="18sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="36dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/save"
                style="@style/CouchPlayButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:nextFocusUp="@id/server_url"
                android:text="@string/settings_save" />

            <Button
                android:id="@+id/reset"
                style="@style/CouchPlayButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:nextFocusUp="@id/server_url"
                android:text="@string/settings_reset" />

            <Button
                android:id="@+id/cancel"
                style="@style/CouchPlayButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:nextFocusUp="@id/server_url"
                android:text="@string/settings_cancel" />
        </LinearLayout>

        <TextView
            android:id="@+id/version"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:textColor="@color/cp_muted"
            android:textSize="16sp" />
    </LinearLayout>
</ScrollView>
