<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Ohne AndroidX: Plattform-Themes (dunkel). -->
    <style name="Theme.CouchPlay" parent="android:Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@color/cp_bg</item>
        <item name="android:colorBackground">@color/cp_bg</item>
        <item name="android:textColor">@color/cp_text</item>
        <item name="android:textColorPrimary">@color/cp_text</item>
        <item name="android:textColorSecondary">@color/cp_muted</item>
        <item name="android:colorAccent">@color/cp_focus</item>
        <item name="android:statusBarColor">@color/cp_bg</item>
        <item name="android:navigationBarColor">@color/cp_bg</item>
    </style>

    <style name="Theme.CouchPlay.Fullscreen">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>

    <style name="CouchPlayButton" parent="android:Widget.DeviceDefault.Button">
        <item name="android:background">@drawable/button_bg</item>
        <item name="android:textColor">@color/cp_text</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:paddingStart">32dp</item>
        <item name="android:paddingEnd">32dp</item>
        <item name="android:minHeight">64dp</item>
        <item name="android:focusable">true</item>
        <item name="android:stateListAnimator">@null</item>
    </style>
</resources>
