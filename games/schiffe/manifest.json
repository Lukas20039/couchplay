        { "value": "mittel", "label": "Mittel" },
        { "value": "schwer", "label": "Schwer" }
      ],
      "default": "mittel"
    },
    {
      "type": "select",
      "key": "fleet",
      "label": "Flotte",
      "options": [
        { "value": "klassisch", "label": "Klassisch (5 Schiffe)" },
        { "value": "gross", "label": "Groß (10 Schiffe)" }
      ],
      "default": "klassisch"
    },
    { "type": "toggle", "key": "extraShot", "label": "Nach Treffer nochmal schießen", "default": true },
    { "type": "toggle", "key": "touching", "label": "Schiffe dürfen sich berühren", "default": false }
  ]
}
